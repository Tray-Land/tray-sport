<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TraySport.Views.GameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ContextText"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="WhenText"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
            </Grid>

            <Grid ColumnSpacing="10" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image
                    x:Name="HomeBadge"
                    Width="24"
                    Height="24" />
                <TextBlock
                    x:Name="HomeName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="HomeScore"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Image
                    x:Name="AwayBadge"
                    Grid.Row="1"
                    Width="24"
                    Height="24" />
                <TextBlock
                    x:Name="AwayName"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="AwayScore"
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>

            <TextBlock
                x:Name="VenueText"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Visibility="Collapsed" />

            <HyperlinkButton
                x:Name="RecapButton"
                Margin="-10,-4,0,-4"
                Click="RecapButton_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE714;" />
                    <TextBlock x:Name="RecapText" Text="Watch recap on YouTube" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>
    </Border>
</UserControl>
