<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TraySport.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TraySport.Views">

    <Grid Padding="12,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="4,0,12,0">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Tray icon" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <GridView
                            x:Name="IconPicker"
                            AutomationProperties.Name="Tray icon"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionChanged="IconPicker_SelectionChanged"
                            SelectionMode="Single">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:IconOption">
                                    <Grid
                                        Width="52"
                                        Height="52"
                                        AutomationProperties.Name="{x:Bind Label}"
                                        ToolTipService.ToolTip="{x:Bind Label}">
                                        <Image
                                            Width="32"
                                            Height="32"
                                            Source="{x:Bind Image}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock
                            x:Name="IconHint"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="Sport icons match your taskbar's light or dark theme. Star a team to use its logo." />
                        <InfoBar
                            x:Name="IconError"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Warning" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="General" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock
                                x:Name="StartupDescription"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Keep your scores a click away after you sign in." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.Name="Start with Windows"
                            IsEnabled="False"
                            OffContent=""
                            OnContent=""
                            Toggled="StartupToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="VersionText"
                    Margin="2,16,0,0"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                <TextBlock
                    x:Name="DataPlanText"
                    Margin="2,0,0,0"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                <HyperlinkButton
                    Margin="-10,0,0,0"
                    Click="DataSourceLink_Click"
                    Content="Scores and team data from TheSportsDB" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
