<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TraySport.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TraySport.Views"
    Background="Transparent">

    <Grid Padding="16,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Sport" />
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                AutomationProperties.Name="Find a team"
                Click="AddButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Find a team">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                AutomationProperties.Name="Refresh"
                Click="RefreshButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Errors keep the last good content visible underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--  Favorites  -->
        <ListView
            x:Name="FavoritesList"
            Grid.Row="2"
            Margin="-4,0,0,0"
            IsItemClickEnabled="True"
            ItemClick="FavoritesList_ItemClick"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,0,0,0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FavoriteCard">
                    <Border
                        AutomationProperties.Name="{x:Bind AccessibleSummary, Mode=OneWay}"
                        ContextRequested="Card_ContextRequested"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Image
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Source="{x:Bind Badge}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind League}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Spacing="6">
                                <!--  Last result  -->
                                <Grid ColumnSpacing="8" Visibility="{x:Bind LastVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Center">
                                        <Border
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            Style="{StaticResource OutcomePillStyle}"
                                            Visibility="{x:Bind WinVisibility, Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="W" />
                                        </Border>
                                        <Border
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            Style="{StaticResource OutcomePillStyle}"
                                            Visibility="{x:Bind LossVisibility, Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="L" />
                                        </Border>
                                        <Border
                                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                            Style="{StaticResource OutcomePillStyle}"
                                            Visibility="{x:Bind DrawVisibility, Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="D" />
                                        </Border>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind LastScore, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind LastMatchup, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind LastWhen, Mode=OneWay}" />
                                        <Button
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            AutomationProperties.Name="{x:Bind RecapLabel}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="RecapButton_Click"
                                            Tag="{x:Bind RecapUrl, Mode=OneWay}"
                                            ToolTipService.ToolTip="Watch the recap on YouTube"
                                            Visibility="{x:Bind RecapVisibility, Mode=OneWay}">
                                            <FontIcon FontSize="14" Glyph="&#xE714;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!--  Next game  -->
                                <Grid ColumnSpacing="8" Visibility="{x:Bind NextVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Next" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind NextMatchup, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind NextWhen, Mode=OneWay}" />
                                </Grid>

                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="No recent or upcoming games."
                                    Visibility="{x:Bind EmptyVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Padding="24"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE734;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No favorite teams yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Star a team to see its latest score and next game here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="EmptyFindButton"
                HorizontalAlignment="Center"
                Click="AddButton_Click"
                Content="Find a team"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="3" Padding="0,0,4,0">
            <TextBlock
                x:Name="UpdatedText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
